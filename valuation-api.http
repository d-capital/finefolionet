@baseUrl = http://localhost:64663
@articleApiToken = {{$processEnv ARTICLE_API_TOKEN}}

### Add or update a year's historical free cash flow
POST {{baseUrl}}/valuation/NASDAQ/MSFT/free-cash-flow
Content-Type: application/json

{
  "year": 2024,
  "value": 72800
}

### Read DCF valuation using historical free-cash-flow growth
GET {{baseUrl}}/valuation/dcf/en/NASDAQ/MSFT

### Update asset fundamentals and classification
PATCH {{baseUrl}}/asset-fundamentals/NASDAQ/MSFT
Content-Type: application/json

{
  "peg": 1.25,
  "netIncome5yCagr": 12.5,
  "isBroadIndexPart": true
}

### Read full article information by URL name
GET {{baseUrl}}/article/market-outlook

### Create an article (ID is generated by the database)
POST {{baseUrl}}/article
Content-Type: application/json
Authorization: Bearer {{articleApiToken}}

{
  "urlName": "market-outlook",
  "language": "en",
  "title": "Market outlook",
  "excerpt": "A brief overview of the market.",
  "metaTitle": "Market outlook",
  "metaDescription": "An overview of current market trends.",
  "content": "Article body.",
  "publishedAt": "2026-11-17",
  "isHidden": false
}

### Replace an article by ID
PUT {{baseUrl}}/article/1
Content-Type: application/json
Authorization: Bearer {{articleApiToken}}

{
  "urlName": "market-outlook",
  "language": "en",
  "title": "Market outlook",
  "excerpt": "A brief overview of the market.",
  "metaTitle": "Market outlook",
  "metaDescription": "An overview of current market trends.",
  "content": "Updated article body.",
  "publishedAt": "2026-11-17",
  "isHidden": false
}

### Get the ten newest visible articles
GET {{baseUrl}}/article/top
